<?xml version="1.0" encoding="utf-8"?>
<!-- 4x4 위젯: 1단 이번 달 요약, 2단 달력, 3단 고른 날(기본 오늘)의 상세. 연·월 제목은 앱을 열고,
     근무일 칸은 한 번 누르면 고르고 고른 칸을 또 누르거나 상세 칸을 누르면 입력 시트를 연다. 빈 곳은 오늘로 돌아간다 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- 1단: 요약 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_label"
            android:textColor="@color/widget_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="@string/widget_overtime"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_overtime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_dash"
            android:textColor="@color/widget_text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_filled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_text"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/widget_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:max="100"
            android:progressBackgroundTint="@color/widget_line"
            android:progressTint="@color/widget_primary" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_average"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/widget_muted"
        android:textSize="12sp" />

    <!-- 2단: 달력 (요일 줄 + 주 줄은 WorkWidget이 채운다) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView style="@style/WidgetWeekday" android:text="일" android:textColor="@color/widget_red" />
        <TextView style="@style/WidgetWeekday" android:text="월" />
        <TextView style="@style/WidgetWeekday" android:text="화" />
        <TextView style="@style/WidgetWeekday" android:text="수" />
        <TextView style="@style/WidgetWeekday" android:text="목" />
        <TextView style="@style/WidgetWeekday" android:text="금" />
        <TextView style="@style/WidgetWeekday" android:text="토" android:textColor="@color/widget_blue" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_calendar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <!-- 3단: 고른 날의 출퇴근 시각과 근무시간 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:background="@color/widget_line" />

    <LinearLayout
        android:id="@+id/widget_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="6dp">

        <TextView
            android:id="@+id/widget_detail_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_detail_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_detail_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/widget_edit"
            android:textColor="@color/widget_muted"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
