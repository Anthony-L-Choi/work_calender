{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "maxNodeModuleJsDepth": 0,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["js/**/*.js", "sw.js", "tools/**/*.mjs", ".claude/hooks/**/*.mjs"]
}
